Ниже ― аккуратно отформатированный и слегка улучшенный «старт-скрипт», которым удобно пользоваться каждый раз после перезагрузки, когда нужно снова приступить к работе над LFS.
Он делает всё, что требуется к концу Главы 4:

гарантирует наличие каталога /mnt/lfs;

монтирует корневой раздел LFS (и при желании дополнительные);

убирает потенциально мешающий /etc/bash.bashrc;

экспортирует LFS;

напоминает, что пора переходить к работе от имени lfs.

bash
Copy
Edit
#!/bin/bash
#
# lfs-prepare.sh  – подготовка окружения перед продолжением сборки LFS
# запускается от root (sudo) после каждой загрузки хоста

set -e          # при любой ошибке скрипт сразу завершается
set -u          # использование необъявленной переменной = ошибка

### 1. Конфигурация ###########################################################
LFS_MOUNT="/mnt/lfs"          # куда монтируем корень LFS
LFS_DEVICE="/dev/sdb2"        # сам раздел LFS

# Если у вас есть другие разделы – просто раскомментируйте и отредактируйте:
# HOME_MOUNT="/mnt/lfs/home"
# HOME_DEVICE="/dev/sdb5"
###############################################################################

# ---------- функция проверки и (при необходимости) монтирования ------------
check_and_mount() {
  local mp=$1 dev=$2

  if mountpoint -q "$mp"; then
    echo "✓ $mp уже смонтирован."
  else
    [ -b "$dev" ] || { echo "✗ Блочное устройство $dev не найдено!"; exit 1; }
    echo "→ Монтирую $dev → $mp"
    mount "$dev" "$mp"
  fi
}
# --------------------------------------------------------------------------- #

echo "=== Подготовка окружения LFS ==="

# 2. Каталог /mnt/lfs (если вдруг удалён)
[ -d "$LFS_MOUNT" ] || mkdir -pv "$LFS_MOUNT"

# 3. Монтируем корень LFS (+доп. разделы при необходимости)
check_and_mount "$LFS_MOUNT" "$LFS_DEVICE"
# Пример для дополнительных точек:
# check_and_mount "$HOME_MOUNT" "$HOME_DEVICE"

# 4. Убираем «глобальный» /etc/bash.bashrc, чтобы он не влиял на user lfs
if [ -e /etc/bash.bashrc ]; then
  mv -vn /etc/bash.bashrc /etc/bash.bashrc.NOUSE
fi

# 5. Экспорт переменной окружения
export LFS="$LFS_MOUNT"
echo "✓ Переменная LFS=$LFS"

echo -e "\nГотово. Теперь переключайтесь на пользователя lfs:"
echo "    sudo su - lfs"
echo "и продолжайте инструкции начиная с главы 5."

exit 0
